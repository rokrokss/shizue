# Production Environment Variables

# Database
POSTGRES_USER=shizue
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=shizue_accounts


# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.shizue.app/v1/auth/callback/google

# Chrome Extension
CHROME_EXTENSION_ID=your_chrome_extension_id
CHROME_EXTENSION_REDIRECT_URI=chrome-extension://your_chrome_extension_id/callback

# CORS (Chrome Extension IDs)
ALLOWED_ORIGINS='["chrome-extension://your_chrome_extension_id"]'

# Optional: Error tracking
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Cache Configuration (Production optimized)
CACHE_MAX_SIZE=5000
CACHE_DEFAULT_TTL=600

# Performance Settings (Production optimized)
MAX_REQUEST_SIZE=16777216
GZIP_MINIMUM_SIZE=500
CORS_MAX_AGE=86400

# Rate Limiting (Production limits)
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=500/minute
