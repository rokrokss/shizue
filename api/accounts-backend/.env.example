# Application
APP_NAME="Shizue Accounts API"
APP_VERSION="1.0.0"
DEBUG=false

# Database
DATABASE_URL=postgresql+asyncpg://shizue:shizue123@localhost:5432/shizue_accounts


# JWT
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.shizue.ai/v1/auth/google/callback

# CORS
ALLOWED_ORIGINS=["chrome-extension://YOUR_EXTENSION_ID", "http://localhost:3000", "https://shizue.ai"]

# Frontend URLs
FRONTEND_URL=https://shizue.ai
AUTH_SUCCESS_URL=https://shizue.ai/auth/success
AUTH_ERROR_URL=https://shizue.ai/auth/error

# Sentry (optional)
SENTRY_DSN=

# Server
HOST=0.0.0.0
PORT=8000

# Cache Configuration
CACHE_MAX_SIZE=2000
CACHE_DEFAULT_TTL=300

# Performance Settings
MAX_REQUEST_SIZE=16777216
GZIP_MINIMUM_SIZE=500
CORS_MAX_AGE=3600

# Rate Limiting
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_API=100/minute
